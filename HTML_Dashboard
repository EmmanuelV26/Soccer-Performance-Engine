// --- PCA scatter ---
let pcaChart=null;
function renderPCA(){
const ctx=document.getElementById('pcaChart').getContext('2d');
if(pcaChart)pcaChart.destroy();
const filtered=getFiltered();
const groups={};
filtered.forEach(p=>{if(!groups[p.p])groups[p.p]=[];groups[p.p].push(p)});
const datasets=Object.entries(groups).map(([pos,players])=>({
label:pos,
data:players.map(p=>({x:p.px,y:p.py,player:p})),
backgroundColor:selectedPlayer?
(players.some(p=>p.n===selectedPlayer.n)?POS_COLORS[pos]+'cc':POS_COLORS[pos]+'25')
:POS_COLORS[pos]+'88',
pointRadius:selectedPlayer?
(players.map(p=>p.n===selectedPlayer.n?8:2))
:3,
pointHoverRadius:7
}));

// Add similar players highlight
if(selectedPlayer){
const idx=P.indexOf(selectedPlayer);
const sims=findSimilar(idx,8);
const simPlayers=sims.map(s=>P[s.idx]);
datasets.push({
label:'Similar',
data:simPlayers.map(p=>({x:p.px,y:p.py,player:p})),
backgroundColor:'#22d3ee',
borderColor:'#22d3ee',
borderWidth:2,
pointRadius:6,
pointStyle:'triangle'
})
}

pcaChart=new Chart(ctx,{type:'scatter',data:{datasets},
options:{responsive:true,maintainAspectRatio:false,animation:{duration:300},
scales:{x:{title:{display:true,text:'PCA 1 (Attacking →)',color:'#64748b'},
ticks:{color:'#475569',font:{size:10}},grid:{color:'rgba(255,255,255,0.03)'}},
y:{title:{display:true,text:'PCA 2 (Creative ↑)',color:'#64748b'},
ticks:{color:'#475569',font:{size:10}},grid:{color:'rgba(255,255,255,0.03)'}}}
,plugins:{legend:{labels:{color:'#94a3b8',usePointStyle:true,padding:12,
font:{family:"'Sora',sans-serif",size:11}}},
tooltip:{backgroundColor:'#1e293b',borderColor:'rgba(255,255,255,0.1)',borderWidth:1,
titleFont:{family:"'Sora',sans-serif",size:12},
bodyFont:{family:"'Space Mono',monospace",size:11},
callbacks:{title:items=>{const d=items[0]?.raw?.player;return d?d.n:''},
label:item=>{const d=item.raw.player;if(!d)return'';
return[`${d.p} · ${d.t} · ${d.l}`,`Age ${d.a} · €${d.v}M · Rating ${d.pr}`]}
}}}}});
}

function switchTab(tab,el){
currentTab=tab;
document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
el.classList.add('active');
document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
document.getElementById('panel-'+tab).classList.add('active');
if(tab==='similar')renderSimilar();
if(tab==='scout')renderScout();
if(tab==='map')renderPCA();
}

