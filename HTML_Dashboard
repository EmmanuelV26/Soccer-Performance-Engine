<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Soccer Player Recommendation Engine</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Sora:wght@300;400;500;600;700&display=swap');

*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#0b0f1a;--card:#111827;--border:rgba(255,255,255,0.06);--text:#e2e8f0;
--muted:#64748b;--accent:#22d3ee;--accent2:#a78bfa;--green:#34d399;--red:#f87171;
--orange:#fb923c;--blue:#60a5fa}

body{font-family:'Sora',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}

.header{padding:1.5rem 2rem;background:linear-gradient(135deg,#0b0f1a,#1a1f35);
border-bottom:1px solid var(--border)}
.header h1{font-size:1.6rem;font-weight:700;
background:linear-gradient(135deg,var(--accent),var(--accent2));
-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.header p{color:var(--muted);font-size:0.82rem;margin-top:0.2rem}

.layout{display:grid;grid-template-columns:340px 1fr;min-height:calc(100vh - 80px)}

/* --- Sidebar --- */
.sidebar{background:#0e1225;border-right:1px solid var(--border);padding:1.25rem;
overflow-y:auto;max-height:calc(100vh - 80px)}

.section-title{font-size:0.7rem;font-weight:600;text-transform:uppercase;
letter-spacing:0.1em;color:var(--accent);margin:1rem 0 0.5rem}

.search-box{width:100%;padding:0.6rem 0.8rem;background:rgba(255,255,255,0.04);
border:1px solid var(--border);border-radius:8px;color:var(--text);
font-family:'Sora',sans-serif;font-size:0.85rem;outline:none;transition:border 0.2s}
.search-box:focus{border-color:var(--accent)}
.search-box::placeholder{color:var(--muted)}

.filter-row{display:flex;gap:0.4rem;flex-wrap:wrap;margin-top:0.5rem}
.chip{padding:0.3rem 0.65rem;border-radius:6px;font-size:0.72rem;font-weight:500;
cursor:pointer;border:1px solid var(--border);background:rgba(255,255,255,0.03);
color:var(--muted);transition:all 0.15s;user-select:none}
.chip:hover{background:rgba(255,255,255,0.06)}
.chip.active{background:rgba(34,211,238,0.12);border-color:rgba(34,211,238,0.4);color:var(--accent)}

.slider-group{margin-top:0.6rem}
.slider-label{display:flex;justify-content:space-between;font-size:0.75rem;color:var(--muted);margin-bottom:0.25rem}
.slider-label span{color:var(--accent);font-family:'Space Mono',monospace}
input[type=range]{width:100%;accent-color:var(--accent);background:transparent}

.player-list{margin-top:0.75rem;display:flex;flex-direction:column;gap:0.4rem;max-height:320px;overflow-y:auto}
.player-item{padding:0.6rem 0.75rem;background:rgba(255,255,255,0.02);border:1px solid var(--border);
border-radius:8px;cursor:pointer;transition:all 0.15s;display:flex;justify-content:space-between;align-items:center}
.player-item:hover{background:rgba(34,211,238,0.06);border-color:rgba(34,211,238,0.2)}
.player-item.selected{background:rgba(34,211,238,0.1);border-color:var(--accent)}
.player-item .pi-name{font-size:0.82rem;font-weight:500}
.player-item .pi-meta{font-size:0.7rem;color:var(--muted)}
.player-item .pi-badge{font-size:0.65rem;padding:0.15rem 0.45rem;border-radius:4px;
font-weight:600;font-family:'Space Mono',monospace}

/* --- Main area --- */
.main{padding:1.25rem;overflow-y:auto;max-height:calc(100vh - 80px)}
.tabs{display:flex;gap:0.5rem;margin-bottom:1.25rem}
.tab{padding:0.5rem 1.1rem;border-radius:8px;font-size:0.8rem;font-weight:500;
cursor:pointer;border:1px solid var(--border);background:rgba(255,255,255,0.03);
color:var(--muted);transition:all 0.2s}
.tab:hover{background:rgba(255,255,255,0.06)}
.tab.active{background:rgba(167,139,250,0.12);border-color:rgba(167,139,250,0.4);color:var(--accent2)}

.panel{display:none}
.panel.active{display:block}

.results-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem}
.result-card{background:var(--card);border:1px solid var(--border);border-radius:10px;
padding:1rem;position:relative;transition:all 0.2s}
.result-card:hover{transform:translateY(-2px);border-color:rgba(255,255,255,0.12)}
.result-card .rc-rank{position:absolute;top:0.75rem;right:0.75rem;font-size:1.5rem;
font-weight:700;color:rgba(255,255,255,0.06);font-family:'Space Mono',monospace}
.result-card .rc-name{font-size:0.95rem;font-weight:600;margin-bottom:0.15rem}
.result-card .rc-team{font-size:0.75rem;color:var(--muted);margin-bottom:0.6rem}
.rc-stats{display:grid;grid-template-columns:1fr 1fr;gap:0.35rem}
.rc-stat{font-size:0.72rem;font-family:'Space Mono',monospace}
.rc-stat .rc-label{color:var(--muted)}
.rc-stat .rc-val{color:var(--green)}
.rc-stat .rc-val.neg{color:var(--red)}
.sim-bar{height:3px;background:rgba(255,255,255,0.05);border-radius:2px;margin-top:0.6rem}
.sim-fill{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--accent),var(--accent2))}

.scatter-container{height:500px;position:relative}

.compare-section{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:1rem}
.compare-card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:1.25rem}
.compare-card h3{font-size:0.95rem;font-weight:600;margin-bottom:0.75rem}
.radar-container{height:350px;position:relative}

.stat-row{display:flex;justify-content:space-between;align-items:center;padding:0.35rem 0;
border-bottom:1px solid rgba(255,255,255,0.03);font-size:0.78rem}
.stat-row:last-child{border:none}
.stat-bar-bg{width:80px;height:5px;background:rgba(255,255,255,0.06);border-radius:3px;margin:0 0.5rem}
.stat-bar-fill{height:100%;border-radius:3px}

@media(max-width:900px){.layout{grid-template-columns:1fr}
.sidebar{max-height:none;border-right:none;border-bottom:1px solid var(--border)}}
</style>
</head>
<body>

<div class="header">
<h1>Soccer Player Recommendation Engine</h1>
<p>3,370 players · 12 leagues · Powered by KNN + Cosine Similarity + PCA</p>
</div>

<div class="layout">
<div class="sidebar">
<input class="search-box" id="searchBox" placeholder="Search player name..." oninput="onSearch()">

<div class="section-title">Position Filter</div>
<div class="filter-row" id="posFilters"></div>

<div class="section-title">League Tier</div>
<div class="filter-row" id="tierFilters"></div>

<div class="section-title">Max Age</div>
<div class="slider-group">
<div class="slider-label"><span id="ageVal">39</span></div>
<input type="range" min="17" max="39" value="39" id="ageSlider" oninput="onFilterChange()">
</div>

<div class="section-title">Max Value (€M)</div>
<div class="slider-group">
<div class="slider-label"><span id="valVal">150</span></div>
<input type="range" min="1" max="150" value="150" id="valSlider" oninput="onFilterChange()">
</div>

<div class="section-title">Select a Player</div>
<div class="player-list" id="playerList"></div>
</div>

<div class="main">
<div class="tabs">
<div class="tab active" onclick="switchTab('similar',this)">Similar Players</div>
<div class="tab" onclick="switchTab('scout',this)">Scout Undervalued</div>
<div class="tab" onclick="switchTab('map',this)">Player Map (PCA)</div>
</div>

<div class="panel active" id="panel-similar">
<div id="similarResults" class="results-grid">
<p style="color:var(--muted);font-size:0.85rem;grid-column:1/-1">
← Select a player from the sidebar to find similar players</p>
</div>
</div>

<div class="panel" id="panel-scout">
<div id="scoutResults" class="results-grid"></div>
</div>

<div class="panel" id="panel-map">
<div class="scatter-container"><canvas id="pcaChart"></canvas></div>
</div>
</div>
</div>

