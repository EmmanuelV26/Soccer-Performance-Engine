}

// --- Cosine similarity in JS ---
function cosineSim(a,b){
let dot=0,ma=0,mb=0;
for(let i=0;i<a.length;i++){dot+=a[i]*b[i];ma+=a[i]*a[i];mb+=b[i]*b[i]}
return dot/(Math.sqrt(ma)*Math.sqrt(mb)+1e-10);
}

function getFeatureVec(p){
return[p.g,p.as,p.xg,p.xa,p.sh,p.kp,p.tk,p.it,p.pp,p.pc,p.dr,p.pa/100,p.ae];
}

// Normalize features
const allVecs=P.map(getFeatureVec);
const means=allVecs[0].map((_,i)=>allVecs.reduce((s,v)=>s+v[i],0)/allVecs.length);
const stds=allVecs[0].map((_,i)=>{
const m=means[i];const v=allVecs.reduce((s,r)=>s+(r[i]-m)**2,0)/allVecs.length;
return Math.sqrt(v)||1});
const normVecs=allVecs.map(v=>v.map((x,i)=>(x-means[i])/stds[i]));

function findSimilar(playerIdx,n=12){
const vec=normVecs[playerIdx];
const sims=normVecs.map((v,i)=>({idx:i,sim:cosineSim(vec,v)}))
.filter(s=>s.idx!==playerIdx)
.sort((a,b)=>b.sim-a.sim).slice(0,n);
return sims;
}

function renderSimilar(){
const container=document.getElementById('similarResults');
