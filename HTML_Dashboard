tf.appendChild(c)});
}

function getFiltered(){
let f=P;
if(selectedPos.size)f=f.filter(p=>selectedPos.has(p.p));
if(selectedTier.size)f=f.filter(p=>selectedTier.has(p.lt));
const maxAge=+document.getElementById('ageSlider').value;
const maxVal=+document.getElementById('valSlider').value;
f=f.filter(p=>p.a<=maxAge&&p.v<=maxVal);
const q=document.getElementById('searchBox').value.toLowerCase();
if(q)f=f.filter(p=>p.n.toLowerCase().includes(q));
return f;
}

function onSearch(){onFilterChange()}
function onFilterChange(){
document.getElementById('ageVal').textContent=document.getElementById('ageSlider').value;
document.getElementById('valVal').textContent='€'+document.getElementById('valSlider').value+'M';
renderPlayerList();
if(currentTab==='scout')renderScout();
if(currentTab==='map')renderPCA();
}

function renderPlayerList(){
const list=document.getElementById('playerList');
const filtered=getFiltered().slice(0,80);
list.innerHTML=filtered.map((p,i)=>`
<div class="player-item ${selectedPlayer&&selectedPlayer.n===p.n?'selected':''}"
